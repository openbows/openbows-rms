{
  "name": "openbows-rms-web",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w @openbows/admin",
    "dev:pos": "npm run dev -w @openbows/pos",
    "dev:kds": "npm run dev -w @openbows/kds",
    "build:admin": "npm run build -w @openbows/admin",
    "build:pos": "npm run build -w @openbows/pos",
    "build:kds": "npm run build -w @openbows/kds",
    "build": "npm run build:admin && npm run build:pos && npm run build:kds"
  }
}
